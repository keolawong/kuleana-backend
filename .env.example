# Kuleana Systems - Environment Configuration Template
DB_HOST=ep-jolly-sky-akn41zbq-pooler.c-3.us-west-2.aws.neon.tech
DB_NAME=neondb
DB_SSLMODE=require

# Flyway Migration Account (High Privilege)
DB_MIGRATION_USER=neondb_owner
