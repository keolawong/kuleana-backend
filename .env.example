# Spring Boot Datasource & Flyway URLs
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-jolly-sky-akn41zbq-pooler.c-3.us-west-2.aws.neon.tech/neondb?sslmode=require&currentSchema=auth
SPRING_FLYWAY_URL=jdbc:postgresql://ep-jolly-sky-akn41zbq-pooler.c-3.us-west-2.aws.neon.tech/neondb?sslmode=require&currentSchema=auth

# JWT Security
JWT_SECRET=your_256_bit_jwt_secret_here
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
